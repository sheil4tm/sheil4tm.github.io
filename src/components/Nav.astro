---
import { SECTIONS, SECTION_META } from '../lib/sections';

const pathname = Astro.url.pathname;
---

<button
  type="button"
  id="nav-toggle"
  class="md:hidden inline-flex items-center justify-center rounded-full border border-ink/10 bg-surface/80 px-3 py-2 text-sm text-ink"
  aria-expanded="false"
  aria-controls="primary-nav"
>
  Menu
</button>

<nav
  id="primary-nav"
  class="nav-panel hidden md:flex flex-col md:flex-row md:items-center gap-1 absolute md:static left-4 right-4 top-[4.5rem] z-40 rounded-card md:rounded-none border md:border-0 border-ink/10 bg-surface/95 md:bg-transparent p-3 md:p-0 shadow-soft md:shadow-none backdrop-blur"
  aria-label="Primary"
>
  <a
    href="/"
    class:list={[
      'rounded-full px-3 py-1.5 text-sm font-medium transition',
      pathname === '/' || pathname === ''
        ? 'bg-lilac-soft text-lilac-deep'
        : 'text-muted hover:text-ink hover:bg-surface',
    ]}
  >
    Library
  </a>
  {
    SECTIONS.map((section) => {
      const href = `/${section}/`;
      const active = pathname === href || pathname.startsWith(`/${section}/`);
      return (
        <a
          href={href}
          class:list={[
            'rounded-full px-3 py-1.5 text-sm font-medium transition',
            active
              ? 'bg-lilac-soft text-lilac-deep'
              : 'text-muted hover:text-ink hover:bg-surface',
          ]}
        >
          {SECTION_META[section].label}
        </a>
      );
    })
  }
  <a
    href="/about/"
    class:list={[
      'rounded-full px-3 py-1.5 text-sm font-medium transition',
      pathname.startsWith('/about')
        ? 'bg-lilac-soft text-lilac-deep'
        : 'text-muted hover:text-ink hover:bg-surface',
    ]}
  >
    About
  </a>
  <a
    href="/search/"
    class:list={[
      'rounded-full px-3 py-1.5 text-sm font-medium transition',
      pathname.startsWith('/search')
        ? 'bg-lilac-soft text-lilac-deep'
        : 'text-muted hover:text-ink hover:bg-surface',
    ]}
  >
    Search
  </a>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    if (!nav) return;
    const isHidden = nav.classList.contains('hidden');
    nav.classList.toggle('hidden', !isHidden);
    nav.classList.toggle('flex', isHidden);
    toggle.setAttribute('aria-expanded', String(isHidden));
  });
</script>
