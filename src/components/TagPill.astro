---
interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className = '' } = Astro.props;
---

<a
  href={`/tags/${encodeURIComponent(tag)}/`}
  class:list={[
    'inline-flex items-center rounded-full bg-lilac-soft/70 px-3 py-1 text-xs font-medium text-lilac-deep transition hover:bg-mochi-soft hover:text-mochi-deep',
    className,
  ]}
>
  #{tag}
</a>
