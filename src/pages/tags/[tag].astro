---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged with ${tag}.`}>
  <section class="mb-10 fade-up">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-lilac-deep">
      Tag
    </p>
    <h1 class="font-serif text-4xl text-ink sm:text-5xl">#{tag}</h1>
    <p class="mt-4 text-lg text-muted">
      {posts.length} {posts.length === 1 ? 'entry' : 'entries'} on this tag.
    </p>
  </section>

  <div class="grid gap-5">
    {posts.map((post, i) => <PostCard post={post} style={`animation-delay: ${i * 50}ms`} />)}
  </div>
</BaseLayout>
