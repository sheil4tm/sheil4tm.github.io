---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Space for thoughts in a variety of stuff... at the moment~"
>
  <section class="fade-up mx-auto max-w-3xl">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-lilac-deep">
      About
    </p>
    <h1 class="font-serif text-4xl text-ink sm:text-5xl">Sheila</h1>

    <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-start">
      <div
        class="flex h-36 w-36 shrink-0 items-center justify-center rounded-card border border-ink/10 bg-lilac-soft/60 text-4xl font-serif text-lilac-deep shadow-card"
        aria-label="Avatar placeholder"
      >
        S
      </div>

      <div class="space-y-5">
        <p class="text-xl leading-relaxed text-ink">
          Space for thoughts in a variety of stuff... at the moment~
        </p>
        <p class="leading-relaxed text-muted">
          <!-- Edit this bio anytime in src/pages/about.astro -->
          This corner of the internet is a small library of notes — books, film, series,
          tech, esports, and whatever else lands on the shelf.
        </p>
      </div>
    </div>

    <section class="mt-14">
      <h2 class="mb-4 font-serif text-2xl text-ink">Elsewhere</h2>
      <ul class="space-y-3 text-muted">
        <li>
          <span class="font-medium text-ink">GitHub</span>
          —
          <a
            href="https://github.com/sheil4tm"
            class="text-lilac-deep underline decoration-lilac/40 underline-offset-4 hover:text-mochi-deep"
          >
            @sheil4tm
          </a>
        </li>
        <!-- Add more social links here when ready -->
        <li class="text-sm italic opacity-70">
          More links coming soon — edit this list in <code class="rounded bg-lilac-soft/70 px-1.5 py-0.5 text-lilac-deep">src/pages/about.astro</code>
        </li>
      </ul>
    </section>

    <section
      class="mt-14 rounded-card border border-dashed border-lilac/40 bg-surface/60 p-6 shadow-card"
    >
      <h2 class="font-serif text-2xl text-ink">Newsletter</h2>
      <p class="mt-3 text-muted">
        A quiet spot reserved for a future newsletter signup. Not live yet — just holding
        the space.
      </p>
      <form class="mt-5 flex flex-col gap-3 sm:flex-row" aria-label="Newsletter placeholder">
        <label class="sr-only" for="newsletter-email">Email</label>
        <input
          id="newsletter-email"
          type="email"
          placeholder="you@example.com"
          disabled
          class="w-full rounded-full border border-ink/10 bg-cream/80 px-4 py-2.5 text-sm text-muted opacity-70"
        />
        <button
          type="button"
          disabled
          class="rounded-full bg-lilac/50 px-5 py-2.5 text-sm font-semibold text-lilac-deep opacity-70"
        >
          Coming soon
        </button>
      </form>
    </section>
  </section>
</BaseLayout>
